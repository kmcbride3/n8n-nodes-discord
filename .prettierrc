{
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "printWidth": 120,
  "endOfLine": "auto",
  "overrides": [
    {
      "files": ".prettierrc",
      "options": { "parser": "json" }
    },
    {
      "files": "**/*.md",
      "options": {
        "parser": "markdown",
        "proseWrap": "always",
        "htmlWhitespaceSensitivity": "ignore"
      }
    }
  ]
}

