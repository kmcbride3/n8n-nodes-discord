{
  "name": "@kmcbride3/n8n-nodes-discord-experimental",
  "version": "0.8.0-alpha.1",
  "description": "nodes to trigger workflows from Discord or send interactive messages. Uses the components API which allows to create dialogs (e.g. attach buttons and wait for the user to click on them)",
  "keywords": [
    "n8n",
    "node",
    "discord",
    "trigger",
    "n8n-node",
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kmcbride3/n8n-nodes-discord",
  "author": {
    "name": "kmcbride3",
    "url": "https://github.com/kmcbride3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmcbride3/n8n-nodes-discord.git"
  },
  "main": "index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint:fix": "eslint src/nodes src/credentials --fix",
    "lint:format": "prettier \"src/nodes\" \"src/credentials\" \"docs\" \"**/*.md\" --write",
    "lint": "pnpm lint:format && pnpm lint:fix",
    "publish": "pnpm build && pnpm publish --access public",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:comprehensive": "node tests/run-comprehensive-tests.js",
    "test:unit": "node tests/run-comprehensive-tests.js unit",
    "test:integration": "node tests/run-comprehensive-tests.js integration",
    "test:security": "node tests/run-comprehensive-tests.js security"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/DiscordApi.credentials.js",
      "dist/credentials/DiscordBotApi.credentials.js",
      "dist/credentials/DiscordOAuth2Api.credentials.js",
      "dist/credentials/DiscordWebhookApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Discord/Discord.node.js",
      "dist/nodes/Discord/DiscordTrigger.node.js",
      "dist/nodes/Discord/DiscordInteraction.node.js"
    ]
  },
  "pnpm": {
    "overrides": {
      "event-pubsub": "npm:@node-ipc/event-pubsub@^6.0.2",
      "glob": "^10.4.5",
      "@typescript-eslint/utils": "^8.45.0",
      "form-data": "^4.0.4",
      "js-yaml@<3.14.2": ">=3.14.2",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "^9.37.0",
        "event-pubsub": "npm:@node-ipc/event-pubsub@^6.0.2",
        "glob": "^10.4.5",
        "@typescript-eslint/utils": "^8.45.0"
      }
    },
    "onlyBuiltDependencies": [
      "bufferutil",
      "eslint-plugin-n8n-nodes-base",
      "utf-8-validate",
      "zlib-sync"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.1",
    "@eslint/markdown": "^7.5.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/node-ipc": "^9.2.3",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.4",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "gulp": "^5.0.1",
    "jest": "^30.2.0",
    "n8n-core": "^1.120.1",
    "n8n-workflow": "^1.118.1",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "discord.js": "^14.25.1",
    "node-ipc": "^12.0.0",
    "tweetnacl": "^1.0.3"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.9",
    "utf-8-validate": "^6.0.5",
    "zlib-sync": "^0.1.10"
  },
  "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b"
}
