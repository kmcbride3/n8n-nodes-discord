{
  "name": "@kmcbride3/n8n-nodes-discord-experimental",
  "version": "0.8.0-alpha.1",
  "description": "nodes to trigger workflows from Discord or send interactive messages. Uses the components API which allows to create dialogs (e.g. attach buttons and wait for the user to click on them)",
  "keywords": [
    "n8n",
    "node",
    "discord",
    "trigger",
    "n8n-node",
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kmcbride3/n8n-nodes-discord",
  "author": {
    "name": "kmcbride3",
    "url": "https://github.com/kmcbride3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmcbride3/n8n-nodes-discord.git"
  },
  "main": "index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "publish": "pnpm build && pnpm publish --access public",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:comprehensive": "node tests/run-comprehensive-tests.js",
    "test:unit": "node tests/run-comprehensive-tests.js unit",
    "test:integration": "node tests/run-comprehensive-tests.js integration",
    "test:security": "node tests/run-comprehensive-tests.js security"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/DiscordApi.credentials.js",
      "dist/credentials/DiscordBotApi.credentials.js",
      "dist/credentials/DiscordOAuth2Api.credentials.js",
      "dist/credentials/DiscordWebhookApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Discord/Discord.node.js",
      "dist/nodes/Discord/DiscordTrigger.node.js",
      "dist/nodes/Discord/DiscordInteraction.node.js",
      "dist/nodes/Discord/v2/DiscordV2.node.js",
      "dist/nodes/Discord/v2/DiscordGetV2.node.js",
      "dist/nodes/Discord/v2/DiscordTriggerV2.node.js"
    ]
  },
  "pnpm": {
    "overrides": {
      "event-pubsub": "npm:@node-ipc/event-pubsub@^6.0.2",
      "glob": "^13.0.5",
      "@typescript-eslint/utils": "^8.54.0",
      "form-data": "^4.0.4",
      "qs": "^6.14.1",
      "lodash": "^4.17.23",
      "undici": "^6.23.0",
      "parse-url": "^10.0.3",
      "js-yaml@<3.14.2": ">=3.14.2",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "eslint": "^9.19.0",
      "minimatch": "^10.2.1"
    },
    "onlyBuiltDependencies": [
      "bufferutil",
      "eslint-plugin-n8n-nodes-base",
      "utf-8-validate",
      "zlib-sync"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^7.5.1",
    "@n8n/node-cli": "^0.20.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@types/node-ipc": "^9.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.6",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "gulp": "^5.0.1",
    "jest": "^30.2.0",
    "n8n-workflow": "^2.9.0",
    "prettier": "^3.8.1",
    "release-it": "^19.2.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "discord.js": "^14.25.1",
    "node-ipc": "npm:@achrinza/node-ipc@^10.1.11",
    "tweetnacl": "^1.0.3"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0",
    "utf-8-validate": "^6.0.6",
    "zlib-sync": "^0.1.10"
  },
  "packageManager": "pnpm@10.30.1+sha512.3590e550d5384caa39bd5c7c739f72270234b2f6059e13018f975c313b1eb9fefcc09714048765d4d9efe961382c312e624572c0420762bdc5d5940cdf9be73a"
}
