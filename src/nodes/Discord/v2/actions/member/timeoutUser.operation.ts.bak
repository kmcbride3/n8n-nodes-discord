import type { IExecuteFunctions, INodeExecutionData, INodeProperties } from 'n8n-workflow'

import { addMemberRole } from '../../helpers/discord-operations'
import { createV2DiscordClient, getV2DiscordCredentials } from '../../helpers'

export const properties: INodeProperties[] = [
  {
    displayName: 'User ID',
    name: 'userId',
    type: 'string',
    required: true,
    displayOptions: {
      show: {
        resource: ['action'],
        operation: ['addRole'],
      },
    },
    default: '',
    description: 'The ID of the user to add the role to.',
  },
  {
    displayName: 'Roles',
    name: 'roleUpdateIds',
    required: true,
    type: 'multiOptions',
    displayOptions: {
      show: {
        resource: ['action'],
        operation: ['addRole'],
      },
    },
    typeOptions: {
      loadOptionsMethod: 'getRoles',
    },
    default: [],
    description: 'The roles to add to the user.',
  },
  {
    displayName: 'Audit Log Reason',
    name: 'reason',
    type: 'string',
    displayOptions: {
      show: {
        resource: ['action'],
        operation: ['addRole'],
      },
    },
    default: '',
    description: 'Reason for adding the role (will appear in Discord audit logs).',
  },
]

export async function execute(this: IExecuteFunctions): Promise<INodeExecutionData[][]> {
  const returnData: INodeExecutionData[] = []
  const items: INodeExecutionData[] = this.getInputData()

  // Get credentials and create Discord client for member operations
  const credentials = await getV2DiscordCredentials.call(this)
  const client = await createV2DiscordClient.call(this, credentials)

  if (!client) {
    throw new Error('Discord client is required for member operations')
  }

  for (let itemIndex = 0; itemIndex < items.length; itemIndex++) {
    const guildId = this.getNodeParameter('guildId', itemIndex) as string
    const userId = this.getNodeParameter('userId', itemIndex) as string
    const roleId = this.getNodeParameter('roleId', itemIndex) as string
    const reason = this.getNodeParameter('reason', itemIndex, '') as string

    if (!guildId || !userId || !roleId) {
      continue
    }

    try {
      await addMemberRole.call(this, guildId, userId, roleId, reason || undefined, client)

      returnData.push({
        json: {
          success: true,
          guildId,
          userId,
          roleId,
          action: 'addRole',
        },
      })
    } catch (error) {
      returnData.push({
        json: {
          success: false,
          error: error.message,
          guildId,
          userId,
          roleId,
          action: 'addRole',
        },
      })
    }
  }

  return [returnData]
}
